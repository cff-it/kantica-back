meta {
  name: import
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/import
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{secretaryToken}}
}

headers {
  Accept: application/json
}

body:multipart-form {
  file: @file(users/membres-cff.xlsx)
}

docs {
  Importe les lignes valides du fichier (import partiel). Lancer d'abord `members/login-secretary`.
  Chaque ligne valide crée un compte actif, avec le rôle `membre`, sa fiche (voix, téléphone) et son prénom.
  Les lignes invalides sont renvoyées dans `errors` (ligne Excel, nom, motif) et ne créent rien.
  Un email déjà utilisé est ignoré (`skipped`) : relancer la requête ne crée aucun doublon.
  Aucun email n'est envoyé et le mot de passe est aléatoire (inconnu de tous) : les comptes importés ne peuvent
  pas encore se connecter tant qu'un parcours de mot de passe n'existe pas.
}

tests {
  test("lignes valides importées, les autres rapportées", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.total).to.equal(6);
    expect(res.body.data.error_count).to.equal(2);
    expect(res.body.data.created + res.body.data.skipped_count).to.equal(4);
  });
}
