meta {
  name: show
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/members/{{memberId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{secretaryToken}}
}

headers {
  Accept: application/json
}

docs {
  Fiche d'un membre : identité, voix, contacts et statut du compte (`data.status`, `pending` ou `active`).
  Lancer d'abord `login-secretary` (token `secretaryToken`) et `auth/register` (`memberId`).
  Le token doit appartenir à un compte actif et vérifié ayant le rôle `secretaire` ou `admin` (403 sinon, même pour sa propre fiche :
  un membre passe par `me/profile-get`).

  Le bouton « Valider » de la fiche appelle `members/validate`.
  L'email (`data.profile.contact_mail`) est celui du compte.
}

tests {
  test("fiche du membre", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(bru.getVar("memberId"));
    expect(res.body.data.status).to.be.oneOf(["pending", "active"]);
    expect(res.body.data.profile).to.have.property("last_name");
    expect(res.body.data.profile).to.have.property("contact_mail");
  });
}
