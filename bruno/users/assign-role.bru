meta {
  name: assign-role
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/users/{{memberId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "role": "secretaire"
  }
}

docs {
  Rôle d'un compte (KAN-35, US-25) : `admin`, `secretaire` ou `membre`. Un seul rôle par compte : le rôle choisi
  remplace les autres. Réservé à l'admin (403 sinon) ; lancer d'abord `auth/login` avec un compte admin.

  - 422 sur `role` : rôle inconnu, retrait du rôle Admin au dernier administrateur, ou compte administrateur
    originel (`SUPER_ADMIN_MAIL`), qui garde son rôle
  - 404 pour un compte inconnu
  - Réponse : la ligne de `users/list` du compte
}

tests {
  test("rôle appliqué", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.role).to.equal("secretaire");
  });
}
