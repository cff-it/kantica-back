meta {
  name: profile-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/me/profile
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

tests {
  test("fiche renvoyée", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.include.all.keys(
      "last_name", "first_name", "voice_group", "voice", "phone", "contact_mail", "completed"
    );
  });
}

docs {
  Fiche de l'utilisateur courant. `completed = false` tant qu'elle n'a pas été enregistrée.
  `contact_mail` est l'email du compte (lecture seule).
  Accessible aux comptes en attente de validation.
}
