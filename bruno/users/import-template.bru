meta {
  name: import-template
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/import/template
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

tests {
  test("modèle xlsx renvoyé", function () {
    expect(res.status).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("spreadsheetml.sheet");
    expect(res.getHeader("content-disposition")).to.contain("modele-import-membres.xlsx");
  });
}

docs {
  Télécharge le modèle Excel (`modele-import-membres.xlsx`) : une feuille « Réponses » avec les 25 en-têtes de la
  « Fiche d'identification CFF » (formulaire de recensement), dans leur ordre : `Horodateur`, `Nom et prénom(s)`,
  `Adresse e-mail`, `Adresse`, `Numéro de téléphone`... jusqu'à `Photo d'identité récente`.
  Un export du formulaire se colle donc tel quel dans le modèle. `Horodateur` n'est pas repris par l'import.
  Lancer d'abord `members/login-secretary` (token `secretaryToken`, compte `secretaire` ou `admin` actif et vérifié).
}
