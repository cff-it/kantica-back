{
    "preset": "laravel",
    "rules": {
        "binary_operator_spaces": {
            "default": "single_space",
            "operators": {
                "=>": null,
                "=": null
            }
        },
        "concat_space": {
            "spacing": "none"
        },
        "no_trailing_comma_in_singleline": false,
        "not_operator_with_successor_space": false,
        "whitespace_after_comma_in_array": false,
        "new_with_parentheses": false
    }
}
