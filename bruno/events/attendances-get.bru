meta {
  name: attendances-get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/events/{{eventId}}/attendances
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

vars:pre-request {
  eventId: 1
}

tests {
  test("liste de saisie des présences", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.event.id).to.be.a("number");
    expect(res.body.data.members).to.be.an("array");
    expect(res.body.data.present_count).to.be.a("number");
    expect(res.body.data.total_count).to.equal(res.body.data.members.length);
  });
}

docs {
  Liste de saisie des présences d'un événement (KAN-12, US-11). Lancer d'abord `login-secretary` (token `secretaryToken`).
  Le token doit appartenir à un compte actif et vérifié ayant le rôle `secretaire` ou `admin` (403 sinon, avant tout 404).

  `eventId` vaut 1 par défaut (variable de la requête) : mettre l'identifiant d'un événement existant. La création des
  événements n'est couverte par aucune story ; un événement se crée à la main en base.

  Réponse : `data.event` (`id`, `name`, `date_start`), `data.present_count` et `data.total_count` (« 5 / 9 présents »),
  `data.members` : un membre actif par ligne (`id`, `last_name`, `first_name`, `voice_group`, `voice`, `present`), triés
  par nom puis prénom. Les comptes en attente et le compte administrateur originel ne sont pas listés.
  404 pour un événement inconnu ou un identifiant non numérique.
}
