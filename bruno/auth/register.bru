meta {
  name: register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "mail": "{{memberMail}}",
    "password": "{{memberPassword}}",
    "password_confirmation": "{{memberPassword}}"
  }
}

script:pre-request {
  // Email unique à chaque lancement pour éviter le 422 « email déjà utilisé »
  bru.setVar("memberMail", `choriste+${Date.now()}@example.com`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.token);
    bru.setVar("memberId", res.body.user.id);
  }
}

docs {
  Étape 1 de l'inscription. Mot de passe : 8 caractères minimum, majuscule, minuscule,
  chiffre et caractère spécial. Limité à 5 requêtes par minute.

  Enregistre `token`, `memberId` et `memberMail` en variables d'exécution (non écrites sur disque).
}

tests {
  test("compte créé en attente de validation", function () {
    expect(res.status).to.equal(201);
    expect(res.body.token).to.be.a("string");
    expect(res.body.user.status).to.equal("pending");
    expect(res.body.user.email_verified).to.equal(false);
    expect(res.body.user.roles).to.include("membre");
  });
}
